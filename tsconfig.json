{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "types": [
      "node",
      "@playwright/test"
    ],

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "resolveJsonModule": true,

    "strict": true,
    "skipLibCheck": true,

    "noEmit": true
  },

  "include": [
    "tests/**/*.ts",
    "playwright.config.ts"
  ],

  "exclude": [
    "node_modules",
    "playwright-report",
    "test-results",
    "tests/reports"
  ]
}